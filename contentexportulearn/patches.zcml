<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:monkey="http://namespaces.plone.org/monkey"
    i18n_domain="ulearn5">

    <include package="collective.monkeypatcher" />

    <monkey:patch
        description="Upload json to folder domain"
        class="collective.exportimport.export_other.BaseExport"
        original="download"
        replacement=".patches.download"
        />

    <monkey:patch
        description="Portlets con imagen/fichero (NamedBlobImage) exportables a JSON"
        module="collective.exportimport.export_other"
        original="json_compatible"
        replacement=".patches.json_compatible"
        />

</configure>